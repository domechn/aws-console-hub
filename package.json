{
  "name": "aws-console-hub",
  "productName": "AWS Console Hub",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-account AWS console desktop app with isolated sessions, credential-command federation, quick jump and recent resources",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-app-name.js && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "activity": "node scripts/activity-report.js",
    "ai-smoke": "node scripts/ai-smoke.mjs",
    "ai-audit": "node --no-warnings scripts/ai-audit.mjs",
    "start": "electron-vite preview",
    "build:icons": "electron scripts/build-icons.js",
    "dist": "electron-vite build && electron-builder --mac dir",
    "test": "vitest run"
  },
  "build": {
    "appId": "dev.domdou.aws-console-hub",
    "productName": "AWS Console Hub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "target": "dir",
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools"
    }
  },
  "dependencies": {
    "@aws-sdk/client-acm": "3.1116.0",
    "@aws-sdk/client-api-gateway": "3.1116.0",
    "@aws-sdk/client-apigatewayv2": "3.1116.0",
    "@aws-sdk/client-auto-scaling": "3.1116.0",
    "@aws-sdk/client-cloudformation": "3.1116.0",
    "@aws-sdk/client-cloudfront": "3.1116.0",
    "@aws-sdk/client-cloudtrail": "3.1116.0",
    "@aws-sdk/client-cloudwatch": "3.1116.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1116.0",
    "@aws-sdk/client-cost-explorer": "3.1116.0",
    "@aws-sdk/client-dynamodb": "3.1116.0",
    "@aws-sdk/client-ec2": "3.1116.0",
    "@aws-sdk/client-ecr": "3.1116.0",
    "@aws-sdk/client-ecs": "3.1116.0",
    "@aws-sdk/client-eks": "3.1116.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "3.1116.0",
    "@aws-sdk/client-elasticache": "3.1116.0",
    "@aws-sdk/client-eventbridge": "3.1116.0",
    "@aws-sdk/client-guardduty": "3.1116.0",
    "@aws-sdk/client-iam": "3.1116.0",
    "@aws-sdk/client-kinesis": "3.1116.0",
    "@aws-sdk/client-kms": "3.1116.0",
    "@aws-sdk/client-lambda": "3.1116.0",
    "@aws-sdk/client-organizations": "3.1116.0",
    "@aws-sdk/client-rds": "3.1116.0",
    "@aws-sdk/client-resource-groups-tagging-api": "3.1116.0",
    "@aws-sdk/client-route-53": "3.1116.0",
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/client-secrets-manager": "3.1116.0",
    "@aws-sdk/client-sfn": "3.1116.0",
    "@aws-sdk/client-sns": "3.1116.0",
    "@aws-sdk/client-sqs": "3.1116.0",
    "@aws-sdk/client-ssm": "3.1116.0",
    "@aws-sdk/client-sts": "3.1116.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "license": "MIT",
  "author": "domechn"
}
